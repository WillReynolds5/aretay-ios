// Aretay — Secrets template
//
// Copy this file to `Secrets.xcconfig` (gitignored) and fill in real values.
//
// xcconfig quirk: `//` is a comment delimiter, so URLs must escape the double
// slash with `$()` (an empty variable expansion). The result `https:/$()/...`
// evaluates to `https://...` at build time.

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
